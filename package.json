{
  "name": "uppro",
  "version": "0.0.1",
  "description": "A CLI tool for managing and applying reusable project configuration presets with inheritance, templates, and step automation",
  "keywords": [
    "automation",
    "cli",
    "configuration",
    "preset",
    "project-setup",
    "scaffold",
    "setup"
  ],
  "homepage": "https://github.com/OsirisFrik/setup-project",
  "bugs": {
    "url": "https://github.com/OsirisFrik/setup-project/issues"
  },
  "license": "CC-BY-NC-4.0",
  "author": "OsirisFrik",
  "repository": {
    "type": "git",
    "url": "https://github.com/OsirisFrik/setup-project.git"
  },
  "bin": {
    "uppro": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "dist/",
    "preset.schema.json"
  ],
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --project tsconfig.app.json",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\" \"tests/**/**/*.test.ts\"",
    "test:unit": "node --experimental-strip-types --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --experimental-strip-types --experimental-vm-modules --test \"tests/integration/**/*.test.ts\"",
    "test:watch": "node --experimental-strip-types --test --watch \"tests/**/*.test.ts\" \"tests/**/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "oxfmt": "^0.47.0",
    "typescript": "^6.0.3"
  },
  "preferGlobal": true,
  "engines": {
    "node": ">=22.6.0"
  }
}
